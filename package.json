{
  "name": "deckhand",
  "version": "0.1.0",
  "description": "An HTML presentation editor built for AI. Edit by hand, leave notes for your agent, hand off in one click.",
  "type": "module",
  "bin": {
    "deckhand": "server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js samples/sample-deck.html",
    "test": "node --test \"test/unit/**/*.test.js\" && playwright test --project=e2e",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test --project=e2e",
    "test:live": "DECKHAND_LIVE=1 playwright test --project=live"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "parse5": "^8.1.1",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
